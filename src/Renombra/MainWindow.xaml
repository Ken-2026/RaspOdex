<Window x:Class="Renombra.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="clr-namespace:Renombra.Core"
    Title="Renombra · EXIF" Icon="Renombra.ico"
    Width="1160" Height="800" MinWidth="860" MinHeight="620"
    WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
    AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop"
    Loaded="OnLoaded" PreviewKeyDown="OnWindowKeyDown">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style x:Key="ColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F4F6FB" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style x:Key="FileCell" TargetType="TextBlock">
            <Setter Property="Margin" Value="11,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="#172345" Padding="22,16">
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Right" Padding="9,5" CornerRadius="5"
                        VerticalAlignment="Center" Background="#29365D">
                    <TextBlock x:Name="ExifStatus" Foreground="#DFE6FD" FontSize="12" />
                </Border>
                <Border DockPanel.Dock="Left" Background="#515FEC" Width="42" Height="42"
                        CornerRadius="9" Margin="0,0,12,0">
                    <Path Data="M3,6 H19 M14,2 L19,6 L14,10 M19,15 H3 M8,11 L3,15 L8,19"
                          Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel>
                    <TextBlock Text="Renombra" FontSize="24" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock Text="Renombrado masivo de archivos" Foreground="#C1CCED" FontSize="12" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Line}"
                BorderThickness="0,0,0,1" Padding="20,10">
            <DockPanel x:Name="FilesToolbar">
                <CheckBox DockPanel.Dock="Right" x:Name="SubfoldersCheck" Content="Incluir subcarpetas"
                          VerticalAlignment="Center" Margin="14,0,0,0"
                          ToolTip="Al añadir una carpeta, también busca archivos en sus subcarpetas." />
                <WrapPanel>
                    <Menu Margin="0,0,10,0" VerticalAlignment="Center" Background="Transparent">
                        <MenuItem Header="_Archivo">
                            <MenuItem Header="Añadir archivos" Click="OnAddFiles" />
                            <MenuItem Header="Añadir carpeta" Click="OnAddFolder" />
                            <Separator />
                            <MenuItem Header="Vaciar lista" Click="OnClear" />
                        </MenuItem>
                        <MenuItem Header="_Renombrar">
                            <MenuItem Header="Fecha y nombre" Click="OnUseDateName" />
                            <MenuItem Header="Viaje con país y fecha" Click="OnUseTravelTemplate" />
                            <MenuItem Header="Restablecer reglas" Click="OnResetRules" />
                        </MenuItem>
                        <MenuItem Header="_Ubicación">
                            <MenuItem Header="Buscar sin Internet con GeoNames" Click="OnLookupLocationOffline" />
                            <MenuItem Header="Buscar en línea con OpenStreetMap…" Click="OnLookupLocation" />
                            <Separator />
                            <MenuItem Header="Borrar ubicación del lote" Click="OnClearLocation" />
                        </MenuItem>
                        <MenuItem Header="A_yuda">
                            <MenuItem Header="Guía de campos y ubicación" Click="OnShowHelp" />
                        </MenuItem>
                    </Menu>
                    <Button x:Name="AddFilesButton" Content="Añadir archivos" Click="OnAddFiles"
                            Margin="0,0,7,0" ToolTip="Ctrl+O" />
                    <Button x:Name="AddFolderButton" Content="Añadir carpeta" Click="OnAddFolder"
                            Margin="0,0,14,0" ToolTip="Ctrl+Mayús+O" />
                    <Button x:Name="RemoveButton" Content="Quitar selección" Click="OnRemove"
                            Margin="0,0,7,0" ToolTip="Quita las filas seleccionadas de la lista." />
                    <Button x:Name="ClearButton" Content="Vaciar lista" Click="OnClear"
                            ToolTip="Quita todas las filas de la lista." />
                </WrapPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2" Margin="20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="315" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="RulesPanel" Margin="16,14">
                        <DockPanel Margin="0,0,0,12">
                            <Button DockPanel.Dock="Right" Content="Restablecer" Click="OnResetRules"
                                    Padding="8,3" FontSize="11" />
                            <TextBlock Text="Reglas" FontSize="17" FontWeight="SemiBold" />
                        </DockPanel>

                        <Label Content="_Buscar" Target="{Binding ElementName=SearchBox}" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="SearchBox" AutomationProperties.Name="Buscar" TextChanged="OnRuleChanged" Margin="0,0,0,9" />
                        <Label Content="Reempla_zar por" Target="{Binding ElementName=ReplacementBox}" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="ReplacementBox" AutomationProperties.Name="Reemplazar por" TextChanged="OnRuleChanged" Margin="0,0,0,10" />
                        <UniformGrid Columns="2" Margin="0,0,0,2">
                            <CheckBox x:Name="RegexCheck" Content="Expresión regular" Click="OnRuleClick" />
                            <CheckBox x:Name="MatchCaseCheck" Content="Distinguir mayús." Click="OnRuleClick"
                                      ToolTip="Distinguir mayúsculas y minúsculas al buscar." />
                            <CheckBox x:Name="AllMatchesCheck" Content="Todas las veces" IsChecked="True" Click="OnRuleClick"
                                      ToolTip="Desmarca para reemplazar solo la primera coincidencia." />
                            <CheckBox x:Name="ExtensionCheck" Content="Editar extensión" Click="OnRuleClick"
                                      ToolTip="Aplica la búsqueda, la plantilla y el cambio de mayúsculas al nombre completo." />
                        </UniformGrid>

                        <Border Height="1" Background="{StaticResource Line}" Margin="0,7,0,12" />
                        <Label Content="_Plantilla" Target="{Binding ElementName=TemplateBox}" Style="{StaticResource FieldLabel}" />
                        <DockPanel Margin="0,0,0,7">
                            <Button DockPanel.Dock="Right" x:Name="SavePresetButton" Content="Guardar…"
                                    Click="OnSavePreset" Margin="6,0,0,0" Padding="8,4"
                                    ToolTip="Guarda la plantilla y los ajustes de numeración." />
                            <ComboBox x:Name="PresetBox" AutomationProperties.Name="Plantillas guardadas y de ejemplo"
                                      SelectionChanged="OnPresetChanged" DisplayMemberPath="Name"
                                      ToolTip="Selecciona una plantilla guardada o de ejemplo." />
                        </DockPanel>
                        <TextBox x:Name="TemplateBox" AutomationProperties.Name="Plantilla" TextChanged="OnRuleChanged"
                                 ToolTip="Ejemplo: {fecha:yyyyMMdd}_{nombre}_{n}" Margin="0,0,0,7" />
                        <WrapPanel Margin="0,0,0,3">
                            <Button Content="{}{nombre}" Style="{StaticResource TokenButton}" Click="OnToken"
                                    ToolTip="Nombre tras buscar y reemplazar, sin extensión." />
                            <Button Content="{}{n}" Style="{StaticResource TokenButton}" Click="OnToken"
                                    ToolTip="Número según el orden de la lista." />
                            <Button Content="{}{fecha}" Style="{StaticResource TokenButton}" Click="OnToken"
                                    ToolTip="Fecha de captura del archivo multimedia. Admite {fecha:yyyyMMdd}." />
                            <Button Content="{}{camara}" Style="{StaticResource TokenButton}" Click="OnToken"
                                    ToolTip="Modelo de cámara o dispositivo." />
                            <Button Content="{}{lugar}" Style="{StaticResource TokenButton}" Click="OnToken"
                                    ToolTip="Lugar escrito para todo este lote. Ejemplo: Indonesia." />
                            <Button Content="{}{pais}" Style="{StaticResource TokenButton}" Click="OnToken"
                                    ToolTip="País aplicado al lote, manualmente o desde GPS." />
                            <Button Content="{}{ciudad}" Style="{StaticResource TokenButton}" Click="OnToken"
                                    ToolTip="Ciudad aplicada al lote, manualmente o desde GPS." />
                            <Button Tag="{}{codigo_pais}" Style="{StaticResource TokenButton}" Click="OnToken"
                                    ToolTip="Código ISO de dos letras aplicado al lote. Ejemplo: ID."><TextBlock Text="{}{codigo_pais}" /></Button>
                            <Button Content="{}{indicador}" Style="{StaticResource TokenButton}" Click="OnToken"
                                    ToolTip="Indicador personalizado del país o viaje. Ejemplo: IND." />
                        </WrapPanel>
                        <Label Content="Ubicación para este lote" Target="{Binding ElementName=LocationBox}" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="LocationBox" AutomationProperties.Name="Lugar para este lote" TextChanged="OnRuleChanged"
                                 ToolTip="Escribe un lugar fijo, como Indonesia, Bali o IND. Se inserta con {lugar}."
                                 Margin="0,0,0,5" />
                        <UniformGrid Columns="4" Margin="0,0,0,8">
                            <StackPanel Margin="0,0,4,0">
                                <Label Content="País" Target="{Binding ElementName=CountryBox}" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="CountryBox" AutomationProperties.Name="País para este lote" TextChanged="OnRuleChanged" />
                            </StackPanel>
                            <StackPanel Margin="4,0">
                                <Label Content="Ciudad" Target="{Binding ElementName=CityBox}" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="CityBox" AutomationProperties.Name="Ciudad para este lote" TextChanged="OnRuleChanged" />
                            </StackPanel>
                            <StackPanel Margin="4,0,0,0">
                                <Label Content="Código" Target="{Binding ElementName=CountryCodeBox}" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="CountryCodeBox" AutomationProperties.Name="Código de país para este lote" TextChanged="OnRuleChanged"
                                         ToolTip="Código ISO de dos letras, por ejemplo ES o ID." />
                            </StackPanel>
                            <StackPanel Margin="4,0,0,0">
                                <Label Content="Indicador" Target="{Binding ElementName=IndicatorBox}" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="IndicatorBox" AutomationProperties.Name="Indicador personalizado" TextChanged="OnRuleChanged"
                                         ToolTip="Tu abreviatura preferida, por ejemplo IND." />
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock Text="Para buscar país y ciudad desde GPS, usa Ubicación en el menú superior. Puedes editar cualquier dato antes de renombrar."
                                   Foreground="{StaticResource Muted}" FontSize="11" Margin="0,-4,0,3" TextWrapping="Wrap" />
                        <TextBlock Text="Modo local: GeoNames © contributors · Modo en línea: OpenStreetMap © contributors."
                                   Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,7" TextWrapping="Wrap" />
                        <Expander Header="Todos los campos" Foreground="{StaticResource Muted}" Margin="0,0,0,6">
                            <StackPanel Margin="0,6,0,0">
                                <WrapPanel>
                                    <Button Content="{}{modificado}" Style="{StaticResource TokenButton}" Click="OnToken" ToolTip="Fecha de modificación del archivo." />
                                    <Button Content="{}{creado}" Style="{StaticResource TokenButton}" Click="OnToken" ToolTip="Fecha de creación del archivo en disco." />
                                    <Button Content="{}{ext}" Style="{StaticResource TokenButton}" Click="OnToken" ToolTip="Extensión sin el punto." />
                                </WrapPanel>
                                <ItemsControl x:Name="ExifTokenList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Insertion}" ToolTip="{Binding Label}" Click="OnToken"
                                                    Style="{StaticResource TokenButton}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>

                        <Border Height="1" Background="{StaticResource Line}" Margin="0,6,0,12" />
                        <Label Content="_Mayúsculas y minúsculas" Target="{Binding ElementName=CaseBox}" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="CaseBox" AutomationProperties.Name="Mayúsculas y minúsculas"
                                  SelectedIndex="0" SelectionChanged="OnRuleChanged" Margin="0,0,0,11">
                            <ComboBoxItem Content="Sin cambios" />
                            <ComboBoxItem Content="minúsculas" />
                            <ComboBoxItem Content="MAYÚSCULAS" />
                            <ComboBoxItem Content="Tipo Título" />
                        </ComboBox>
                        <CheckBox x:Name="NumberCheck" Content="Añadir número al final" Click="OnRuleClick" />
                        <UniformGrid Columns="2" x:Name="NumberPanel">
                            <StackPanel Margin="0,0,6,0">
                                <Label Content="Empezar en" Target="{Binding ElementName=StartBox}" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="StartBox" AutomationProperties.Name="Empezar en" Text="1" TextChanged="OnRuleChanged" />
                            </StackPanel>
                            <StackPanel Margin="6,0,0,0">
                                <Label Content="Dígitos" Target="{Binding ElementName=DigitsBox}" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="DigitsBox" AutomationProperties.Name="Dígitos" Text="3" TextChanged="OnRuleChanged"
                                         ToolTip="Cantidad mínima de dígitos. Ejemplo con 3: 001." />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="15,13">
                        <TextBlock DockPanel.Dock="Right" x:Name="CountText" Text="0 archivos"
                                   Foreground="{StaticResource Muted}" FontSize="12"
                                   AutomationProperties.LiveSetting="Polite" Margin="10,0,0,0" />
                        <TextBlock Text="Vista previa" FontSize="17" FontWeight="SemiBold" />
                    </DockPanel>

                    <DataGrid Grid.Row="1" x:Name="FilesGrid" Visibility="Collapsed" AutomationProperties.Name="Vista previa de archivos"
                              SelectionChanged="OnGridSelectionChanged" HeadersVisibility="Column"
                              SelectionMode="Extended" SelectionUnit="FullRow" RowHeight="37" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                              CanUserReorderColumns="False" CanUserResizeRows="False" IsReadOnly="True"
                              BorderThickness="0" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E9EDF5" Background="White" AlternatingRowBackground="#FAFBFE"
                              EnableRowVirtualization="True" ColumnHeaderStyle="{StaticResource ColumnHeader}">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="AutomationProperties.Name" Value="{Binding OriginalName}" />
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SoftAccent}" />
                                        <Setter Property="Foreground" Value="{StaticResource Ink}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nombre actual" Width="1*" MinWidth="110"
                                                Binding="{Binding OriginalName}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource FileCell}">
                                        <Setter Property="ToolTip" Value="{Binding Row.File.FullPath}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Nuevo nombre" Width="1.12*" MinWidth="115"
                                                Binding="{Binding Row.NewName}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource FileCell}">
                                        <Setter Property="ToolTip" Value="{Binding Row.NewName}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Row.Status}" Value="{x:Static core:RenameStatus.Ready}">
                                                <Setter Property="Foreground" Value="#2B3CB7" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Resultado" Width="0.85*" MinWidth="118">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource FileCell}" Text="{Binding StatusText}"
                                                   ToolTip="{Binding Row.Detail}" Foreground="{Binding StatusColor}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="1" x:Name="EmptyState" Margin="13" BorderThickness="1"
                            BorderBrush="#DCE4F5" CornerRadius="8" Background="#F8FAFF">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                            <Border Background="#E9EDFF" Width="54" Height="54" CornerRadius="13" Margin="0,0,0,12">
                                <Path Data="M1,6 H8 L10,9 H24 V22 H1 Z M12,12 V19 M8,15.5 H16"
                                      Stroke="{StaticResource Accent}" StrokeThickness="1.7"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Arrastra archivos o carpetas aquí" FontSize="17" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                            <TextBlock Text="Verás los nombres nuevos antes de aplicarlos."
                                       Foreground="{StaticResource Muted}" HorizontalAlignment="Center"
                                       TextWrapping="Wrap" TextAlignment="Center" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" x:Name="InspectorPanel" Visibility="Collapsed"
                            BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"
                            Background="#F8FAFF" Padding="14,10">
                        <Expander x:Name="ExifExpander" IsExpanded="True" Expanded="OnExifToggle" Collapsed="OnExifToggle">
                            <Expander.Header>
                                <TextBlock Text="Datos EXIF" FontWeight="SemiBold" FontSize="15" Margin="5,0" />
                            </Expander.Header>
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock x:Name="ExifFileName" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           Margin="0,0,0,4" />
                                <TextBlock x:Name="InspectorStatus" Foreground="{StaticResource Muted}"
                                           TextWrapping="Wrap" Margin="0,0,0,7" />
                                <ScrollViewer MaxHeight="137" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="ExifValueList">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Click="OnExifValue" Tag="{Binding Insertion}" ToolTip="{Binding Hint}"
                                                        AutomationProperties.Name="{Binding Hint}"
                                                        Padding="9,5" Margin="0,0,6,6" MaxWidth="180" MinWidth="96"
                                                        BorderBrush="#D9E1FF" Background="#F3F5FF">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Label}" FontSize="11"
                                                                   Foreground="{StaticResource Muted}" />
                                                        <TextBlock Text="{Binding Value}" TextTrimming="CharacterEllipsis"
                                                                   Foreground="#2B3BA7" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Expander>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource Line}"
                BorderThickness="0,1,0,0" Padding="20,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button x:Name="UndoButton" Content="Deshacer" Click="OnUndo" Margin="0,0,8,0"
                            ToolTip="Revierte la última tanda de esta sesión." />
                    <Button x:Name="ApplyButton" Content="Renombrar" Click="OnApply"
                            Style="{StaticResource PrimaryButton}" MinWidth="130" />
                </StackPanel>
                <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" Margin="0,0,15,0"
                           TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
